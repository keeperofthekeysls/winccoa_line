"global int id;//Идентификатор документа

main(mapping event)
{
  //Переменные для функции открытия документа

  string fileName = \"c:/d/project.scl\";//Путь документа
  string errMsg;
  int errLine, errColumn;


  //Переменная для хранения имени узла
  string nodeName;

  //переменная для хранения узлов.
  unsigned rootNode, parentNode;
  unsigned node;
  dyn_uint childNodes,searchNode;
  uint cN;

uint node;

string objName;
string currentPath;
dyn_string graphNodes;

  bool b = true;
  //Открытие документа
id = xmlDocumentFromFile(fileName, errMsg, errLine, errColumn);
DebugN(\"File opened\");

  //Читаем первый элемент файла
rootNode = xmlFirstChild(id);
if (isChild(id, rootNode)== false) rootNode = xmlNextSibling(id,rootNode);
nodeName = xmlNodeName(id, rootNode);
if (xmlNodeName(id,rootNode) == \"SCL\")walk(rootNode);
xmlCloseDocument(id);
DebugN(\"File Closed\");
}
//Проверка узлов на наличие дочерних узлов
bool isChild(int idDoc, unsigned rootNode)
{
  if (xmlFirstChild(idDoc, rootNode) < 0)
  {
    DebugN(xmlNodeName(idDoc,rootNode),\"isCHild = false\");
    return false;
  }
  else
  {
    DebugN(xmlNodeName(idDoc,rootNode),\"isCHild = true\");
    return true;
  }
}
void walk (uint node)
{
  if ( node != -1 )
  {
    walk(xmlFirstChild(id, node));
    walk(xmlNextSibling(id, node));
  }
}
