"#uses \"CtrlXml\"
global int gDoc;//Идентификатор документа

main(mapping event)
{
  string fileName = \"C:/D/winccoa_project/wincc_line/data/IEC61850/SCL/project.scl\";
  string errMsg;
  int errLine, errColumn;

  gDoc = xmlDocumentFromFile(fileName, errMsg,errLine, errColumn);
  DebugN(\"Document opened\",gDoc);

  if (gDoc == 0)
  {
    DebugN(\"XmlOpenError\");
    return;
  }

  unsigned root;
  root = xmlFirstChild(gDoc,root);
  DebugN(\"Start walk\");
  walkSclNode(root,0);
  DebugN(\"Stop Walk\");
  xmlCloseDocument(gDoc);
   DebugN(\"Document closed\",gDoc);
}


void walkSclNode(unsigned node, int level)
{
  if (node != -1)
  {
    DebugN(\"node = -1\");
    return;
  }
  string indent  = \"\";
  for (int i = 0; i < level; i++)
    indent += \"  \";

  string nodeName;
  nodeName = xmlNodeName(gDoc, node);
  DebugN(\"NodeName = \" , nodeName);
  int nodeType = xmlNodeType(gDoc, node);

  DebugN(indent + \"Node\", nodeName,\"TYPE\",nodeType);
  unsigned child;
  child = xmlFirstChild(gDoc, node);
  while (child != -1)
  {
    walkSclNode(child,level + 1);
    child = xmlNextSibling(gDoc, child);
    DebugN(indent + \"Return From:\", nodeName);
  }
}


















