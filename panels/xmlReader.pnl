"#uses \"CtrlXml\"
global int id;//Идентификатор документа

main(mapping event)
{
  //Переменные для функции открытия документа

  string fileName = \"c:/d/project.scl\";//Путь документа
  string errMsg;
  int errLine, errColumn;


  //Переменная для хранения имени узла
  string nodeName = \"\";

  //переменная для хранения узлов.
  unsigned rootNode, parentNode;
  unsigned nodeXw;
  dyn_uint childNodes,searchNode;
  uint cN;

uint nodeX;

string objName;
string currentPath;
dyn_string graphNodes;

  bool b = true;
  //Открытие документа
id = xmlDocumentFromFile(fileName, errMsg, errLine, errColumn);
DebugN(\"File opened\");
rootNode = xmlFirstChild(id);
//Читаем первый элемент файла
while(nodeName != \"SCL\")
{
  nodeName = xmlNodeName(id, rootNode);
  rootNode = xmlNextSibling(id, rootNode);
  Debug(nodeName);
}
objName = walk(rootNode, currentPath);

xmlCloseDocument(id);

DebugN(\"File Closed\");
}

string walk (unsigned node, string path)
{
  string nodeName;
  nodeName=xmlNodeName(id, node);
  switch (nodeName)
  {
      case \"SCL\":
    {
      node = xmlFirstChild(id, node);
      DebugN(\"switch node scl\");
      return nodeName;
    }
      case \"Substation\":
      case \"VoltageLevel\":
      case \"Voltage\":
      case \"Bay\":
    default:{
        return \"\";
        break;
      }
      }
  Debug(nodeName);
  if (nodeName == \"SCL\" || node != -1)
  {
    walk(xmlFirstChild(id, node),nodeName);
    walk(xmlNextSibling(id, node),nodeName);
  }
  if ( node != -1 )
  {
    walk(xmlFirstChild(id, node),nodeName);
    walk(xmlNextSibling(id, node),nodeName);
  }
  else
  {
    DebugN(xmlNodeName(id, node),\"Узел последний или нет дочерних узлов\");
  }

}

int fact (int f)
{
  int s = 1;
  for (int i = 1; i < f; i++)
  {
    s = s * fact (i);
    DebugN(s);
  }
}
























//Проверка узлов на наличие дочерних узлов
bool isChild(int idDoc, unsigned rootNode)
{
  if (xmlFirstChild(idDoc, rootNode) < 0)
  {
    DebugN(xmlNodeName(idDoc,rootNode),\"isCHild = false\");
    return false;
  }
  else
  {
    DebugN(xmlNodeName(idDoc,rootNode),\"isCHild = true\");
    return true;
  }
