//Проверка узлов на наличие дочерних узлов
bool isChild(int idDoc, unsigned rootNode)
{
  if (xmlFirstChild(idDoc, rootNode) < 0)
  {
    DebugN(xmlNodeName(idDoc,rootNode),\"isCHild = false\");
    return false;
  }
  else
  {
    DebugN(xmlNodeName(idDoc,rootNode),\"isCHild = true\");
    return true;
  }
}
